# Copy to .env and change for anything beyond a local demo.
APP_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
INTERNAL_SERVICES_SECRET=change-me-too
APP_JWT_EXPIRATION_MS=900000
APP_REFRESH_IDLE_TTL=PT2H
APP_REFRESH_SESSION_TTL=PT12H
APP_REFRESH_COOKIE_SECURE=true
APP_SEED_DEMO_USERS=true
APP_SEED_DEMO_PASSWORD=Demo@1234
AUTH_DB_PASSWORD=auth_secure_password
OPD_DB_PASSWORD=opd_secure_password
LAB_DB_PASSWORD=lab_secure_password

# Field encryption keys (clinical free text). Generate each with: openssl rand -base64 32
# Format id:key[,id2:key2]. Keep an offline copy: losing a key loses the data encrypted with it.
OPD_CRYPTO_KEYS=k1:change-me-generate-with-openssl-rand-base64-32
OPD_CRYPTO_ACTIVE_KEY=k1
LAB_CRYPTO_KEYS=k1:change-me-generate-with-openssl-rand-base64-32
LAB_CRYPTO_ACTIVE_KEY=k1
